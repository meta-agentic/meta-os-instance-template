# Obsidian local workspace state — not shared
.obsidian/workspace*
.obsidian/cache

# Heartbeat / automation run log — machine-local operational data, not canon
automations/runs.jsonl

# meta-os-dashboard instance config, if you keep it pointed here
instance.config.json

# ruflo / claude-flow local state — written per machine when the tooling runs here, not part of the template
.claude-flow/
.claude/proven-config.json
.claude/.proven-config-version
